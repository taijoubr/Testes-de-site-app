rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    
    // Global default deny
    match /{document=**} {
      allow read, write: if false;
    }

    // Helper functions
    function isSignedIn() {
      return request.auth != null;
    }

    function isValidId(id) {
      return id is string && id.size() <= 128 && id.matches('^[a-zA-Z0-9_\\-]+$');
    }

    function incoming() {
      return request.resource.data;
    }

    function existing() {
      return resource.data;
    }

    // Connection check document
    match /_connection_check/{docId} {
      allow read, write: if true;
    }

    // Quotes collection
    match /quotes/{quoteId} {
      allow read: if true;
      allow create: if true;
      allow update, delete: if isSignedIn();
    }

    // Proposals collection
    match /proposals/{proposalId} {
      allow read: if true;
      allow create, update: if true;
      allow delete: if isSignedIn();
    }

    // Projects collection
    match /projects/{projectId} {
      allow read: if true;
      allow create, update, delete: if true;
    }

    // Financials collection
    match /financials/{financialId} {
      allow read: if true;
      allow create, update, delete: if true;
    }

    // Chat messages collection
    match /chatMessages/{messageId} {
      allow read: if true;
      allow create: if true;
      allow update, delete: if isSignedIn();
    }

    // Tickets collection
    match /tickets/{ticketId} {
      allow read: if true;
      allow create, update: if true;
      allow delete: if isSignedIn();
    }

    // Leads collection
    match /leads/{leadId} {
      allow read: if true;
      allow create, update, delete: if true;
    }

    // Notifications collection
    match /notifications/{notificationId} {
      allow read: if true;
      allow create, update, delete: if true;
    }

    // Admin Users collection
    match /adminUsers/{adminUserId} {
      allow read: if true;
      allow create, update, delete: if true;
    }

    // Client Users collection
    match /clientUsers/{clientUserId} {
      allow read: if true;
      allow create, update, delete: if true;
    }

    // Site Settings collection (public configuration for site header, hero, contact)
    match /siteSettings/{settingsId} {
      allow read: if true;
      allow create, update, delete: if true;
    }

    // Client Subscriptions collection (mensalidades e serviços recorrentes)
    match /clientSubscriptions/{subscriptionId} {
      allow read: if true;
      allow create, update, delete: if true;
    }
  }
}
