{
  "entities": {
    "QuoteRequest": {
      "title": "Quote Request",
      "description": "Orçamentos solicitados por clientes",
      "type": "object",
      "properties": {
        "clientName": { "type": "string", "maxLength": 100 },
        "company": { "type": "string", "maxLength": 100 },
        "email": { "type": "string", "maxLength": 100 },
        "phone": { "type": "string", "maxLength": 30 },
        "whatsapp": { "type": "string", "maxLength": 30 },
        "city": { "type": "string", "maxLength": 100 },
        "state": { "type": "string", "maxLength": 50 },
        "projectType": { "type": "string", "maxLength": 100 },
        "description": { "type": "string", "maxLength": 5000 },
        "deadline": { "type": "string", "maxLength": 100 },
        "budgetRange": { "type": "string", "maxLength": 100 },
        "status": { "type": "string", "maxLength": 50 },
        "createdAt": { "type": "string", "maxLength": 50 },
        "updatedAt": { "type": "string", "maxLength": 50 }
      },
      "required": ["clientName", "email", "description", "status"]
    },
    "Proposal": {
      "title": "Proposal",
      "description": "Propostas comerciais geradas e assinadas",
      "type": "object",
      "properties": {
        "quoteId": { "type": "string", "maxLength": 100 },
        "title": { "type": "string", "maxLength": 200 },
        "clientName": { "type": "string", "maxLength": 100 },
        "company": { "type": "string", "maxLength": 100 },
        "description": { "type": "string", "maxLength": 5000 },
        "totalValue": { "type": "number" },
        "paymentTerms": { "type": "string", "maxLength": 500 },
        "status": { "type": "string", "maxLength": 50 },
        "createdAt": { "type": "string", "maxLength": 50 }
      },
      "required": ["title", "clientName", "totalValue", "status"]
    },
    "Project": {
      "title": "Project",
      "description": "Projetos em andamento com tarefas e arquivos",
      "type": "object",
      "properties": {
        "title": { "type": "string", "maxLength": 200 },
        "clientName": { "type": "string", "maxLength": 100 },
        "clientId": { "type": "string", "maxLength": 100 },
        "category": { "type": "string", "maxLength": 100 },
        "description": { "type": "string", "maxLength": 5000 },
        "status": { "type": "string", "maxLength": 50 },
        "progressPercentage": { "type": "number" },
        "estimatedHours": { "type": "number" },
        "completedHours": { "type": "number" }
      },
      "required": ["title", "clientName", "status"]
    },
    "FinancialTransaction": {
      "title": "Financial Transaction",
      "description": "Lançamentos e parcelas financeiras",
      "type": "object",
      "properties": {
        "title": { "type": "string", "maxLength": 200 },
        "type": { "type": "string", "maxLength": 50 },
        "category": { "type": "string", "maxLength": 100 },
        "amount": { "type": "number" },
        "dueDate": { "type": "string", "maxLength": 50 },
        "status": { "type": "string", "maxLength": 50 }
      },
      "required": ["title", "type", "amount", "status"]
    },
    "ChatMessage": {
      "title": "Chat Message",
      "description": "Mensagens de chat em tempo real entre cliente e equipe",
      "type": "object",
      "properties": {
        "senderId": { "type": "string", "maxLength": 100 },
        "senderName": { "type": "string", "maxLength": 100 },
        "senderRole": { "type": "string", "maxLength": 50 },
        "text": { "type": "string", "maxLength": 5000 },
        "timestamp": { "type": "string", "maxLength": 50 }
      },
      "required": ["senderId", "senderName", "text", "timestamp"]
    },
    "AdminUser": {
      "title": "Admin User",
      "description": "Usuários administradores cadastrados para acesso restrito",
      "type": "object",
      "properties": {
        "id": { "type": "string", "maxLength": 100 },
        "name": { "type": "string", "maxLength": 100 },
        "username": { "type": "string", "maxLength": 100 },
        "passwordHash": { "type": "string", "maxLength": 100 },
        "roleTitle": { "type": "string", "maxLength": 100 },
        "createdAt": { "type": "string", "maxLength": 50 },
        "addedBy": { "type": "string", "maxLength": 100 }
      },
      "required": ["id", "name", "username", "passwordHash", "roleTitle"]
    },
    "ClientUser": {
      "title": "Client User",
      "description": "Usuários clientes cadastrados",
      "type": "object",
      "properties": {
        "id": { "type": "string", "maxLength": 100 },
        "name": { "type": "string", "maxLength": 100 },
        "email": { "type": "string", "maxLength": 150 },
        "phone": { "type": "string", "maxLength": 50 },
        "company": { "type": "string", "maxLength": 150 },
        "passwordHash": { "type": "string", "maxLength": 100 },
        "createdAt": { "type": "string", "maxLength": 50 }
      },
      "required": ["id", "name", "email", "passwordHash"]
    },
    "SiteConfig": {
      "title": "Site Config",
      "description": "Configuração pública do site e informações institucionais",
      "type": "object",
      "properties": {
        "companyName": { "type": "string", "maxLength": 200 },
        "logoUrl": { "type": "string" },
        "heroBadge": { "type": "string", "maxLength": 300 },
        "heroTitle": { "type": "string", "maxLength": 500 },
        "heroSubtitle": { "type": "string", "maxLength": 2000 },
        "phone": { "type": "string", "maxLength": 50 },
        "whatsapp": { "type": "string", "maxLength": 50 },
        "email": { "type": "string", "maxLength": 150 },
        "address": { "type": "string", "maxLength": 300 },
        "announcementBanner": { "type": "string", "maxLength": 500 },
        "isAnnouncementActive": { "type": "boolean" },
        "primaryColor": { "type": "string", "maxLength": 50 },
        "maintenanceMode": { "type": "boolean" },
        "lastUpdated": { "type": "string", "maxLength": 100 },
        "updatedBy": { "type": "string", "maxLength": 100 }
      }
    },
    "ClientSubscription": {
      "title": "Client Subscription",
      "description": "Mensalidades e assinaturas recorrentes de clientes",
      "type": "object",
      "properties": {
        "id": { "type": "string", "maxLength": 100 },
        "clientName": { "type": "string", "maxLength": 150 },
        "clientEmail": { "type": "string", "maxLength": 150 },
        "serviceName": { "type": "string", "maxLength": 200 },
        "monthlyValue": { "type": "number" },
        "billingCycleDay": { "type": "number" },
        "status": { "type": "string", "enum": ["ativo", "inadimplente", "suspenso", "cancelado"] },
        "startDate": { "type": "string", "maxLength": 50 },
        "nextDueDate": { "type": "string", "maxLength": 50 },
        "paymentMethod": { "type": "string", "enum": ["pix", "cartao", "boleto", "transferencia"] },
        "notes": { "type": "string", "maxLength": 1000 },
        "lastPaymentDate": { "type": "string", "maxLength": 50 },
        "pixCopyPaste": { "type": "string", "maxLength": 500 }
      },
      "required": ["id", "clientName", "serviceName", "monthlyValue", "billingCycleDay", "status", "nextDueDate"]
    },
    "ServiceItem": {
      "title": "Service Item",
      "description": "Serviços oferecidos no site",
      "type": "object",
      "properties": {
        "id": { "type": "string", "maxLength": 100 },
        "title": { "type": "string", "maxLength": 200 },
        "slug": { "type": "string", "maxLength": 200 },
        "iconName": { "type": "string", "maxLength": 100 },
        "shortDesc": { "type": "string", "maxLength": 1000 },
        "description": { "type": "string", "maxLength": 5000 },
        "avgTime": { "type": "string", "maxLength": 100 },
        "startingPrice": { "type": "string", "maxLength": 100 },
        "benefits": { "type": "array" },
        "technologies": { "type": "array" }
      },
      "required": ["id", "title", "description"]
    },
    "ServiceContract": {
      "title": "Service Contract",
      "description": "Contratos formais de prestação de serviço gerados automaticamente",
      "type": "object",
      "properties": {
        "contractNumber": { "type": "string", "maxLength": 100 },
        "quoteId": { "type": "string", "maxLength": 100 },
        "projectTitle": { "type": "string", "maxLength": 200 },
        "totalValue": { "type": "number" },
        "status": { "type": "string", "maxLength": 50 },
        "createdAt": { "type": "string", "maxLength": 50 }
      },
      "required": ["contractNumber", "quoteId", "projectTitle", "totalValue", "status"]
    },
    "PortfolioProject": {
      "title": "Portfolio Project",
      "description": "Casos de sucesso e projetos no portfólio público do site",
      "type": "object",
      "properties": {
        "id": { "type": "string", "maxLength": 100 },
        "title": { "type": "string", "maxLength": 200 },
        "subtitle": { "type": "string", "maxLength": 500 },
        "category": { "type": "string", "maxLength": 100 },
        "image": { "type": "string" },
        "description": { "type": "string", "maxLength": 5000 },
        "tags": { "type": "array" },
        "metrics": { "type": "string", "maxLength": 200 },
        "clientName": { "type": "string", "maxLength": 150 },
        "year": { "type": "string", "maxLength": 20 }
      },
      "required": ["id", "title", "description", "category"]
    }
  },
  "firestore": {
    "/portfolio/{portfolioId}": {
      "schema": { "$ref": "#/entities/PortfolioProject" },
      "description": "Coleção de projetos do portfólio público do site"
    },
    "/contracts/{contractId}": {
      "schema": { "$ref": "#/entities/ServiceContract" },
      "description": "Coleção de contratos prestação de serviços"
    },
    "/siteSettings/{settingsId}": {
      "schema": { "$ref": "#/entities/SiteConfig" },
      "description": "Configurações institucionais públicas e ao vivo do site"
    },
    "/clientSubscriptions/{subscriptionId}": {
      "schema": { "$ref": "#/entities/ClientSubscription" },
      "description": "Coleção de mensalidades e assinaturas recorrentes de clientes"
    },
    "/services/{serviceId}": {
      "schema": { "$ref": "#/entities/ServiceItem" },
      "description": "Catálogo de serviços exibidos no site público"
    },
    "/quotes/{quoteId}": {
      "schema": { "$ref": "#/entities/QuoteRequest" },
      "description": "Coleção de orçamentos"
    },
    "/proposals/{proposalId}": {
      "schema": { "$ref": "#/entities/Proposal" },
      "description": "Coleção de propostas"
    },
    "/projects/{projectId}": {
      "schema": { "$ref": "#/entities/Project" },
      "description": "Coleção de projetos"
    },
    "/financials/{financialId}": {
      "schema": { "$ref": "#/entities/FinancialTransaction" },
      "description": "Coleção financeira"
    },
    "/chatMessages/{messageId}": {
      "schema": { "$ref": "#/entities/ChatMessage" },
      "description": "Coleção de mensagens"
    },
    "/adminUsers/{adminUserId}": {
      "schema": { "$ref": "#/entities/AdminUser" },
      "description": "Coleção de administradores cadastrados"
    },
    "/clientUsers/{clientUserId}": {
      "schema": { "$ref": "#/entities/ClientUser" },
      "description": "Coleção de clientes cadastrados"
    }
  }
}
